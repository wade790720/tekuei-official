# 官網環境變數範例（複製為 .env.local）

# 資料一律走同網域 /api，開發時是本機的 Worker 和 .wrangler/state 的 R2，不會寫到正式站
# VITE_ADMIN_KEY=   # 僅本機開發略過登入，正式站勿設定

# Check-in LIFF Worker（既有）
# VITE_CHECKIN_WORKER_URL=https://tekuei-checkin.tekuei-xx.workers.dev/checkin
# VITE_CHECKIN_DEV_BYPASS=false  # DEV 預設略過 LIFF。設 false 或 ?liff=1 強制走 LIFF
# VITE_CHECKIN_LIVE=true         # 本機真的 POST Worker（預設 dry-run）
