# 官網環境變數範例（複製為 .env.local）

# About CMS：production 預設走同網域 /api；開發預設用 bundled data.json
# VITE_USE_REMOTE=true
# VITE_DEV_PROXY_TARGET=https://tekuei.com
# VITE_API_BASE=
# VITE_ADMIN_KEY=   # 僅本機開發略過登入，正式站勿設定

# Check-in LIFF Worker（既有）
# VITE_CHECKIN_WORKER_URL=https://tekuei-checkin.tekuei-xx.workers.dev/checkin
