{
  "name": "tekuei-official",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime=false",
    "lint": "eslint . && node scripts/noSlop.ts && npm run typecheck",
    "seed": "node scripts/seed-data.ts",
    "test": "node --test \"scripts/*.test.ts\"",
    "test:phone": "node --test scripts/phoneE164.test.ts",
    "typecheck": "react-router typegen && tsc -p tsconfig.app.json && tsc -p tsconfig.functions.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@tiptap/extension-blockquote": "^3.34.0",
    "@tiptap/extension-code-block": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "lenis": "^1.1.13",
    "libphonenumber-js": "^1.13.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-phone-input-2": "^2.15.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261127.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "wrangler": "^4.169.0"
  }
}
